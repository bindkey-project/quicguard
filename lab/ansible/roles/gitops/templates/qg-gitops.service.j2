[Unit]
Description=Apply QuicGuard lab configuration from Git
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecCondition=/usr/bin/test ! -e /run/qg-lab/busy
ExecStart=/usr/bin/ansible-pull \
    --url {{ gitops_repo_url }} \
    --checkout {{ gitops_branch }} \
    --directory {{ gitops_checkout_dir }} \
    --clean \
    --inventory {{ gitops_checkout_dir }}/lab/ansible/inventory.yml \
    --limit {{ inventory_hostname }} \
    --connection local \
    {{ gitops_playbook }} 
